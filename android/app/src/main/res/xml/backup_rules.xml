<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes flutter_secure_storage's Keystore-wrapped preferences from auto-backup
  (Android < 12). Restoring a Google Drive backup across devices breaks the RSA-OAEP
  key wrapper and the Clerk JWT becomes unreadable.
  See docs/flutter_secure_storage > "Disabling Auto Backup".
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
</full-backup-content>
