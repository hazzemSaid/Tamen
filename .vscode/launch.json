{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tamen (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SUPABASE_URL=${input:supabaseUrl}",
        "--dart-define=SUPABASE_KEY=${input:supabaseKey}",
        "--dart-define=GOOGLE_WEB_CLIENT_ID=${input:googleWebClientId}"
      ]
    },
    {
      "name": "Tamen (debug, offline UI)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    }
  ],
  "inputs": [
    {
      "id": "supabaseUrl",
      "type": "promptString",
      "description": "Supabase URL (https://<ref>.supabase.co)"
    },
    {
      "id": "supabaseKey",
      "type": "promptString",
      "description": "Supabase publishable key (sb_publishable_…)",
      "password": true
    },
    {
      "id": "googleWebClientId",
      "type": "promptString",
      "description": "Google Web client ID (…apps.googleusercontent.com, for serverClientId)"
    }
  ]
}
